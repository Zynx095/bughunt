# Copy to .env (never commit .env). All values are optional.

# --- AI providers (backend only; never exposed to the browser) ---
# auto = first configured provider; or force: gemini | openai | local
AI_PROVIDER=auto
GEMINI_API_KEY=
# Verify the current model name at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash
# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, LM Studio, vLLM...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
AI_TIMEOUT_S=30

# --- Security ---
# Key-encryption key for the key store: base64 of 32 random bytes, e.g.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# If unset, a development key file is generated in backend/.data/master.key
OMNIFORGE_MASTER_KEY=
# Role used when a request declares none (identity is simulated in the foundation build)
OMNIFORGE_DEFAULT_ROLE=analyst

# --- Storage & limits ---
# OMNIFORGE_DATA_DIR=backend/.data
# OMNIFORGE_DATABASE_URL=sqlite:///path/to/omniforge.db
OMNIFORGE_MAX_UPLOAD_MB=15
OMNIFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CROWDGUARD ---
# Local YOLO weights file (never downloaded). Default search: backend/models/*.pt, then the home folder.
CROWDGUARD_YOLO_WEIGHTS=
# auto (YOLO if weights load, else OpenCV HOG) | yolo | hog
CROWDGUARD_DETECTOR=auto
CROWDGUARD_MAX_VIDEO_MB=100
